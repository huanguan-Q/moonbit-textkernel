// Logic side: predicates and logic functions that only the prover sees.
// No executable code, no type declarations, no `#proof_pure` here.
//
// Every numeric constant is imported from `codes.mbt`, so the specification and
// the kernel cannot disagree about what `&` or `<` is.
//
// Two shapes of definition are used on purpose.
//
// * A `predicate` holds one formula. Disjunctions of parenthesised
//   conjunctions are fine here.
// * A `fn ... -> Bool` is written as a chain of `if` / `else { if ... }`
//   whenever it has more than one case. The logic-side parser rejects
//   `((a) && (b)) || ((c) && (d))` in that position, and it rejects `else if`
//   everywhere; control flow removes the question (see `entity_at`).

/// True when `c` is one of the nine characters `sanitize_filename` rewrites:
/// `/ \ : * ? " < > |`
fn is_illegal_name_char(c : Int) -> Bool {
  (c == CH_SLASH) ||
  (c == CH_BACKSLASH) ||
  (c == CH_COLON) ||
  (c == CH_STAR) ||
  (c == CH_QUESTION) ||
  (c == CH_DQUOTE) ||
  (c == CH_LT) ||
  (c == CH_GT) ||
  (c == CH_PIPE)
}

/// True when `c` is a C0 control character (U+0000..U+001F) or DEL (U+007F).
fn is_control_char(c : Int) -> Bool {
  if (0 <= c) && (c <= CONTROL_MAX) {
    true
  } else {
    c == CH_DEL
  }
}

/// True when `c` is a leading (high) surrogate code unit, U+D800..U+DBFF.
fn is_high_surrogate(c : Int) -> Bool {
  (SURROGATE_LO <= c) && (c <= HIGH_SURR_HI)
}

/// True when `c` is a trailing (low) surrogate code unit, U+DC00..U+DFFF.
fn is_low_surrogate(c : Int) -> Bool {
  (LOW_SURR_LO <= c) && (c <= SURROGATE_HI)
}

/// True when the code unit `src[i]` is half of a well-formed surrogate pair.
///
/// A leading surrogate is paired when the next unit is a trailing one; a
/// trailing surrogate is paired when the previous unit is a leading one. A
/// unit of any other kind is never "paired".
///
/// This is the unit of the rule the whole library follows: a character outside
/// the BMP is two code units and is copied whole. The first version of the
/// escaper specification replaced *every* surrogate unit with `_`, which the
/// implementation, the tests and the proof all agreed on — and which turned an
/// emoji into `__`. The specification was wrong, not the proof.
fn paired_at(src : FixedArray[Int], i : Int) -> Bool {
  if is_high_surrogate(src[i]) {
    (i + 1 < src.length()) && is_low_surrogate(src[i + 1])
  } else {
    if is_low_surrogate(src[i]) {
      (1 <= i) && is_high_surrogate(src[i - 1])
    } else {
      false
    }
  }
}

/// True when `src[i]` is a surrogate code unit that does not belong to a
/// well-formed pair. Only such a half is replaced by `_`.
fn lone_surrogate_at(src : FixedArray[Int], i : Int) -> Bool {
  if is_high_surrogate(src[i]) {
    if paired_at(src, i) {
      false
    } else {
      true
    }
  } else {
    if is_low_surrogate(src[i]) {
      if paired_at(src, i) {
        false
      } else {
        true
      }
    } else {
      false
    }
  }
}

/// `paired_at` for the first `n` units of `src`: a surrogate of the prefix is
/// paired when its other half is inside the prefix too.
fn paired_in_prefix(src : FixedArray[Int], n : Int, i : Int) -> Bool {
  if is_high_surrogate(src[i]) {
    (i + 1 < n) && is_low_surrogate(src[i + 1])
  } else {
    if is_low_surrogate(src[i]) {
      (1 <= i) && is_high_surrogate(src[i - 1])
    } else {
      false
    }
  }
}

/// `lone_surrogate_at` for the first `n` units of `src`.
fn lone_surrogate_in(src : FixedArray[Int], n : Int, i : Int) -> Bool {
  if is_high_surrogate(src[i]) {
    if paired_in_prefix(src, n, i) {
      false
    } else {
      true
    }
  } else {
    if is_low_surrogate(src[i]) {
      if paired_in_prefix(src, n, i) {
        false
      } else {
        true
      }
    } else {
      false
    }
  }
}

/// True when the unit `src[i]` of a name of `n` units becomes `_`.
fn name_char_replaced_at(src : FixedArray[Int], n : Int, i : Int) -> Bool {
  if is_illegal_name_char(src[i]) {
    true
  } else {
    if is_control_char(src[i]) {
      true
    } else {
      lone_surrogate_in(src, n, i)
    }
  }
}

/// One step of the filename sanitizer: the unit written for `src[i]`.
fn sanitize_step(src : FixedArray[Int], n : Int, i : Int, out : Int) -> Bool {
  if name_char_replaced_at(src, n, i) {
    out == CH_UNDERSCORE
  } else {
    out == src[i]
  }
}

/// `min(n, cap)`, spelled out so specs never depend on an external helper.
fn clamped_len(n : Int, cap : Int) -> Int {
  if n < cap {
    n
  } else {
    cap
  }
}

/// The number of units of `src` the sanitizer keeps: `min(length, cap)`, one
/// less when that cut would fall between the two halves of a surrogate pair.
fn adjusted_len(src : FixedArray[Int], cap : Int) -> Int {
  if (1 <= clamped_len(src.length(), cap)) &&
    (clamped_len(src.length(), cap) < src.length()) &&
    is_high_surrogate(src[clamped_len(src.length(), cap) - 1]) &&
    is_low_surrogate(src[clamped_len(src.length(), cap)]) {
    clamped_len(src.length(), cap) - 1
  } else {
    clamped_len(src.length(), cap)
  }
}

/// Every unit of `src` is a dot, and there is at least one. `.`, `..` and `...`
/// name directories; they are never file names.
predicate all_dots(src : FixedArray[Int]) {
  (0 < src.length()) &&
  (∀ i : Int, ((0 <= i) && (i < src.length())) → (src[i] == CH_DOT))
}

/// `dst[0 .. upto)` is exactly the sanitized image of the first `upto` units of
/// a name of `n` units.
predicate sanitized_prefix(
  src : FixedArray[Int],
  dst : FixedArray[Int],
  upto : Int,
  n : Int,
) {
  (0 <= upto) &&
  (∀ i : Int, ((0 <= i) && (i < upto)) → sanitize_step(src, n, i, dst[i]))
}

/// `dst` is the default name, `file`, cut to `cap` units.
predicate is_default_name(dst : FixedArray[Int], cap : Int) {
  (dst.length() == clamped_len(4, cap)) &&
  (∀ i : Int, ((0 <= i) && (i < dst.length())) → (dst[i] == default_code(i)))
}

/// `dst[0 .. w)` contains no `<` and no `>`.
///
/// This is the property that stops `escape_html` / `escape_attr` output from
/// opening or closing a tag when it is spliced into an HTML document.
predicate no_markup_prefix(dst : FixedArray[Int], w : Int) {
  ∀ i : Int, ((0 <= i) && (i < w)) → (dst[i] != CH_LT) && (dst[i] != CH_GT)
}

/// `dst[0 .. w)` contains no `"` and no `'`.
///
/// This is the property that stops attribute-context escaping from terminating
/// a quoted attribute early.
predicate no_quote_prefix(dst : FixedArray[Int], w : Int) {
  ∀ i : Int, ((0 <= i) && (i < w)) → (dst[i] != CH_DQUOTE) &&
    (dst[i] != CH_SQUOTE)
}

/// `src` starts with the ASCII prefix `http://`.
predicate has_http_scheme(src : FixedArray[Int]) {
  (src.length() >= 7) &&
  (src[0] == CH_LOWER_H) &&
  (src[1] == CH_LOWER_T) &&
  (src[2] == CH_LOWER_T) &&
  (src[3] == CH_LOWER_P) &&
  (src[4] == CH_COLON) &&
  (src[5] == CH_SLASH) &&
  (src[6] == CH_SLASH)
}

/// Full functional characterisation of the `http://` -> `https://` rewrite:
/// the eight-unit `https://` header followed by the input tail, unshifted by
/// exactly one position.
///
/// The last conjunct is the point of the whole exercise: it says the tail is
/// copied verbatim, which is precisely what the historical
/// `processed[i].to_string()` bug violated (it turned every tail code unit into
/// its decimal spelling).
predicate https_rewrite_ok(src : FixedArray[Int], dst : FixedArray[Int]) {
  has_http_scheme(src) &&
  (dst.length() == src.length() + 1) &&
  (dst[0] == CH_LOWER_H) &&
  (dst[1] == CH_LOWER_T) &&
  (dst[2] == CH_LOWER_T) &&
  (dst[3] == CH_LOWER_P) &&
  (dst[4] == CH_LOWER_S) &&
  (dst[5] == CH_COLON) &&
  (dst[6] == CH_SLASH) &&
  (dst[7] == CH_SLASH) &&
  (∀ k : Int, ((7 <= k) && (k < src.length())) → dst[k + 1] == src[k])
}

/// The input is returned unchanged, code unit for code unit.
predicate unchanged_ok(src : FixedArray[Int], dst : FixedArray[Int]) {
  (dst.length() == src.length()) &&
  (∀ k : Int, ((0 <= k) && (k < src.length())) → dst[k] == src[k])
}

/// Case split of the rewrite: rewrote the scheme, or copied the input through.
fn rewrite_ok(src : FixedArray[Int], dst : FixedArray[Int]) -> Bool {
  if has_http_scheme(src) {
    https_rewrite_ok(src, dst)
  } else {
    unchanged_ok(src, dst)
  }
}

/// ASCII lower case of one code unit: `A`..`Z` become `a`..`z`, and nothing
/// else changes. A host name has no other upper and lower case pair.
fn ascii_lower(c : Int) -> Int {
  if (ASCII_UPPER_A <= c) && (c <= ASCII_UPPER_Z) {
    c + ASCII_CASE_GAP
  } else {
    c
  }
}

/// `src` starts with `http://`, in any letter case.
predicate http_scheme_ci(src : FixedArray[Int]) {
  (7 <= src.length()) &&
  (ascii_lower(src[0]) == CH_LOWER_H) &&
  (ascii_lower(src[1]) == CH_LOWER_T) &&
  (ascii_lower(src[2]) == CH_LOWER_T) &&
  (ascii_lower(src[3]) == CH_LOWER_P) &&
  (src[4] == CH_COLON) &&
  (src[5] == CH_SLASH) &&
  (src[6] == CH_SLASH)
}

/// `src` starts with `https://`, in any letter case.
predicate https_scheme_ci(src : FixedArray[Int]) {
  (8 <= src.length()) &&
  (ascii_lower(src[0]) == CH_LOWER_H) &&
  (ascii_lower(src[1]) == CH_LOWER_T) &&
  (ascii_lower(src[2]) == CH_LOWER_T) &&
  (ascii_lower(src[3]) == CH_LOWER_P) &&
  (ascii_lower(src[4]) == CH_LOWER_S) &&
  (src[5] == CH_COLON) &&
  (src[6] == CH_SLASH) &&
  (src[7] == CH_SLASH)
}

/// `c` ends an authority. `/`, `?` and `#` are the delimiters of a URL; a
/// backslash is one too, because a browser reads it as a slash in an `http`
/// URL, so `https://cdn.example.com\@evil.com/` has the host `cdn.example.com`.
fn is_authority_end(c : Int) -> Bool {
  if c == CH_SLASH {
    true
  } else {
    if c == CH_BACKSLASH {
      true
    } else {
      if c == CH_QUESTION {
        true
      } else {
        c == CH_HASH
      }
    }
  }
}

/// No unit of `src[start .. upto)` ends an authority.
predicate no_authority_end_before(src : FixedArray[Int], start : Int, upto : Int) {
  ∀ j : Int, ((start <= j) && (j < upto)) → (is_authority_end(src[j]) == false)
}

/// `stop` is the first delimiter at or after `start`, or the end of `src`:
/// nothing before it is a delimiter, and either it is the end or it is one.
predicate authority_end_ok(src : FixedArray[Int], start : Int, stop : Int) {
  (start <= stop) &&
  (stop <= src.length()) &&
  no_authority_end_before(src, start, stop) &&
  ((stop == src.length()) || is_authority_end(src[stop]))
}

/// The tail of `s` from index `from` equals `t`, ignoring ASCII letter case.
///
/// Stated as a relation rather than through a extracted array, so that the
/// prover never has to reason about a second buffer.
predicate ascii_ci_eq_from(s : FixedArray[Int], from : Int, t : FixedArray[Int]) {
  (0 <= from) &&
  ((from + t.length()) == s.length()) &&
  (∀ j : Int, ((0 <= j) && (j < t.length())) →
    (ascii_lower(s[from + j]) == ascii_lower(t[j])))
}

/// `host` is long enough to hold a label in front of `entry`, and the unit just
/// in front of where `entry` would end is a dot.
///
/// The dot is what keeps `cdn.example.com.evil.com` and `notcdn.example.com`
/// out: a subdomain must end in `.entry`, not merely in `entry`.
predicate dot_before_tail(host : FixedArray[Int], entry : FixedArray[Int]) {
  (0 < entry.length()) &&
  ((entry.length() + 2) <= host.length()) &&
  (host[host.length() - entry.length() - 1] == CH_DOT)
}

/// The last `entry.length()` units of `host` equal `entry`, ignoring ASCII
/// letter case.
predicate tail_is_entry(host : FixedArray[Int], entry : FixedArray[Int]) {
  ascii_ci_eq_from(host, host.length() - entry.length(), entry)
}

/// `host` is a subdomain of `entry`: a whole label, a dot, and then `entry`.
predicate host_is_subdomain(host : FixedArray[Int], entry : FixedArray[Int]) {
  dot_before_tail(host, entry) && tail_is_entry(host, entry)
}

/// `host` is `entry` itself or one of its subdomains.
///
/// Both halves ignore ASCII letter case, which is what lets `CDN.EXAMPLE.COM`
/// in. The rule is cut into the three facts above on purpose, so that one
/// kernel decides one comparison. Measured on this toolchain: a single kernel
/// that reads the dot and compares the tail makes the solver time out on its
/// last path, at any limit, although the path is a propositional consequence
/// of its hypotheses. With one comparison per kernel every path closes in
/// milliseconds. Do not merge them back.
predicate host_matches_entry(host : FixedArray[Int], entry : FixedArray[Int]) {
  (0 < entry.length()) &&
  (ascii_ci_eq_from(host, 0, entry) || host_is_subdomain(host, entry))
}

/// `start` is the index just after the last `@` of `a`, or 0 when there is
/// none. The host of an authority begins there: `user@cdn.example.com` has the
/// host `cdn.example.com`, and `cdn.example.com@evil.com` has `evil.com`.
predicate host_start_ok(a : FixedArray[Int], start : Int) {
  (0 <= start) &&
  (start <= a.length()) &&
  (∀ j : Int, ((start <= j) && (j < a.length())) → (a[j] != CH_AT)) &&
  ((start == 0) || (a[start - 1] == CH_AT))
}

/// No unit of `a[from .. upto)` is an `@`.
predicate no_at_from(a : FixedArray[Int], from : Int, upto : Int) {
  ∀ j : Int, ((from <= j) && (j < upto)) → (a[j] != CH_AT)
}

/// The `i`-th code unit of the `"file"` fallback: `f`, `i`, `l`, `e`.
fn default_code(i : Int) -> Int {
  if i == 0 {
    102
  } else {
    if i == 1 {
      105
    } else {
      if i == 2 {
        108
      } else {
        101
      }
    }
  }
}

/// The `i`-th code unit of the `https://` header, for `i` in `[0, 8)`:
/// `h`, `t`, `t`, `p`, `s`, `:`, `/`, `/`.
///
/// `i == 6` and `i == 7` share the trailing `47`, so the chain ends there.
fn https_code(i : Int) -> Int {
  if i == 0 {
    104
  } else {
    if i == 1 {
      116
    } else {
      if i == 2 {
        116
      } else {
        if i == 3 {
          112
        } else {
          if i == 4 {
            115
          } else {
            if i == 5 {
              58
            } else {
              47
            }
          }
        }
      }
    }
  }
}

/// True when the `&` at `dst[i]` (with `i < w`) starts one of the five entities
/// this project can emit, and that entity is fully inside `[0, w)`.
///
/// The bounds conjunct matters: an entity split across the write cursor would be
/// invisible to a naive "starts with &amp;" test.
///
/// The five alternatives are expressed as an `if`/`else` chain rather than a
/// `||` chain, and that is deliberate. The logic-side parser rejects a
/// parenthesised `&&` conjunction when it is an operand of `||`:
///
///     ((a) && (b)) || ((c) && (d))   -> [3002] unexpected `&&` here
///     (a && b) || (c && d)           -> [3002] unexpected `&&` here
///     (a) && (b) || (c) && (d)       -> accepted
///     a && b || c && d               -> accepted
///
/// So the only way to spell five disjuncts of conjunctions is to leave the
/// conjunctions unparenthesised and let `&&` bind tighter than `||`. That makes
/// the meaning of the formula depend on operator precedence, with nothing in
/// the toolchain pinning it: no lint, no test, and the explicit form cannot even
/// be written down as a cross-check.
///
/// Control flow removes the question. A chain of `if c_i { true }` branches is
/// `c1 || c2 || ...` by construction, each `c_i` is a flat `&&` conjunction (no
/// `||` involved, so no precedence to rely on), and the meaning no longer hinges
/// on how the two operators rank.
///
/// The chain is written as nested `else { if ... }` blocks rather than
/// `else if`, because the logic side rejects the latter too (`unexpected if
/// here`); `default_code` and `https_code` above use the same shape for the same
/// reason.
fn entity_at(dst : FixedArray[Int], w : Int, i : Int) -> Bool {
  if ((i + 5) <= w) && (dst[i + 1] == CH_LOWER_A) && (dst[i + 2] == CH_LOWER_M) && (dst[i + 3] == CH_LOWER_P) && (dst[i + 4] == CH_SEMI) {
    true
  } else {
    if ((i + 4) <= w) && (dst[i + 1] == CH_LOWER_L) && (dst[i + 2] == CH_LOWER_T) && (dst[i + 3] == CH_SEMI) {
      true
    } else {
      if ((i + 4) <= w) && (dst[i + 1] == CH_LOWER_G) && (dst[i + 2] == CH_LOWER_T) && (dst[i + 3] == CH_SEMI) {
        true
      } else {
        if ((i + 6) <= w) && (dst[i + 1] == 113) && (dst[i + 2] == 117) && (dst[i + 3] == 111) && (dst[i + 4] == CH_LOWER_T) && (dst[i + 5] == CH_SEMI) {
          true
        } else {
          ((i + 5) <= w) && (dst[i + 1] == 35) && (dst[i + 2] == 51) && (dst[i + 3] == 57) && (dst[i + 4] == CH_SEMI)
        }
      }
    }
  }
}

/// Every `&` inside `dst[0 .. w)` belongs to a complete, recognised entity.
///
/// This is what rules out an escaper that emits `&xmp;` (no raw metacharacter in
/// sight, yet the browser decodes it as something else): the ampersand has to
/// introduce one of the five entities this project is allowed to produce.
///
/// Known expensive, and deliberately left alone. Preservation across the
/// escapers' loops (`escape.mbt` writes five units and bumps `w` in one
/// iteration) is a quantified statement over an array that was just mutated:
/// every `&` already in the prefix must be shown to still start an entity whose
/// extent ends at or before the old cursor, which calls for a case split per
/// index. `moon prove` reports these as `slow_goals` — 18 of them — and they are
/// closed by the `split_vc` stage after Alt-Ergo times out. At the stock time
/// limits the package fails (measured: 417 goals proved, 5 timeout); the gate in
/// `scripts/prove_gate.mjs` proves at 5x limits, which is why it exists.
///
/// A transport lemma (`entity_at` preserved across an in-place update, given a
/// frame condition on the six readable units) was tried and measured: it adds
/// its own proof obligation and leaves the count at 20 slow goals with an
/// identical distribution. The cost is in the shape of the quantified array
/// reasoning, not in a missing intermediate step, so do not re-attempt the lemma.
/// If this ever needs to be faster, the change has to be to the reasoning
/// strategy (or to `entity_at`'s representation), not to the spec's lemmas.
predicate entities_ok_prefix(dst : FixedArray[Int], w : Int) {
  ∀ i : Int, ((0 <= i) && (i < w) && (dst[i] == CH_AMP)) → entity_at(dst, w, i)
}

/// Width of the HTML escape of one code unit: 5 for `&amp;`, 4 for `&lt;` /
/// `&gt;`, 1 for everything else.
fn html_width_at(src : FixedArray[Int], i : Int) -> Int {
  if src[i] == CH_AMP {
    5
  } else {
    if src[i] == CH_LT {
      4
    } else {
      if src[i] == CH_GT {
        4
      } else {
        1
      }
    }
  }
}

/// `dst[k .. k + width)` holds exactly the HTML escape of `src[i]`.
///
/// This is the functional counterpart of `no_markup_prefix`. That predicate only
/// says the output contains no `<` or `>`; this one says which bytes must be
/// there. An escaper that emitted `_` for every unit satisfies the former and
/// violates the latter, which is why the kernels assert this per unit.
///
/// The last two disjuncts are the surrogate rule. A unit that is half of a
/// well-formed pair is copied as it is; an unpaired half becomes `_`.
///
/// Note the disjunction is over the *input* character, so the case split is
/// driven by `src[i]`, not by `dst`: the prover only ever has to match one branch.
predicate html_at(dst : FixedArray[Int], k : Int, src : FixedArray[Int], i : Int) {
  ((src[i] == CH_AMP) && (dst[k] == CH_AMP) && (dst[k + 1] == CH_LOWER_A) && (dst[k + 2] == CH_LOWER_M) && (dst[k + 3] == CH_LOWER_P) && (dst[k + 4] == CH_SEMI)) ||
  ((src[i] == CH_LT) && (dst[k] == CH_AMP) && (dst[k + 1] == CH_LOWER_L) && (dst[k + 2] == CH_LOWER_T) && (dst[k + 3] == CH_SEMI)) ||
  ((src[i] == CH_GT) && (dst[k] == CH_AMP) && (dst[k + 1] == CH_LOWER_G) && (dst[k + 2] == CH_LOWER_T) && (dst[k + 3] == CH_SEMI)) ||
  ((src[i] != CH_AMP) && (src[i] != CH_LT) && (src[i] != CH_GT) && lone_surrogate_at(src, i) && (dst[k] == CH_UNDERSCORE)) ||
  ((src[i] != CH_AMP) && (src[i] != CH_LT) && (src[i] != CH_GT) && (lone_surrogate_at(src, i) == false) && (dst[k] == src[i]))
}

/// Width of the attribute-context escape of one code unit.
fn attr_width_at(src : FixedArray[Int], i : Int) -> Int {
  if src[i] == CH_AMP {
    5
  } else {
    if src[i] == CH_LT {
      4
    } else {
      if src[i] == CH_GT {
        4
      } else {
        if src[i] == CH_DQUOTE {
          6
        } else {
          if src[i] == CH_SQUOTE {
            5
          } else {
            1
          }
        }
      }
    }
  }
}

/// `dst[k .. k + width)` holds exactly the attribute-context escape of
/// `src[i]`.
predicate attr_at(dst : FixedArray[Int], k : Int, src : FixedArray[Int], i : Int) {
  ((src[i] == CH_AMP) && (dst[k] == CH_AMP) && (dst[k + 1] == CH_LOWER_A) && (dst[k + 2] == CH_LOWER_M) && (dst[k + 3] == CH_LOWER_P) && (dst[k + 4] == CH_SEMI)) ||
  ((src[i] == CH_LT) && (dst[k] == CH_AMP) && (dst[k + 1] == CH_LOWER_L) && (dst[k + 2] == CH_LOWER_T) && (dst[k + 3] == CH_SEMI)) ||
  ((src[i] == CH_GT) && (dst[k] == CH_AMP) && (dst[k + 1] == CH_LOWER_G) && (dst[k + 2] == CH_LOWER_T) && (dst[k + 3] == CH_SEMI)) ||
  ((src[i] == CH_DQUOTE) && (dst[k] == CH_AMP) && (dst[k + 1] == 113) && (dst[k + 2] == 117) && (dst[k + 3] == 111) && (dst[k + 4] == CH_LOWER_T) && (dst[k + 5] == CH_SEMI)) ||
  ((src[i] == CH_SQUOTE) && (dst[k] == CH_AMP) && (dst[k + 1] == 35) && (dst[k + 2] == 51) && (dst[k + 3] == 57) && (dst[k + 4] == CH_SEMI)) ||
  ((src[i] != CH_AMP) && (src[i] != CH_LT) && (src[i] != CH_GT) && (src[i] != CH_DQUOTE) && (src[i] != CH_SQUOTE) && lone_surrogate_at(src, i) && (dst[k] == CH_UNDERSCORE)) ||
  ((src[i] != CH_AMP) && (src[i] != CH_LT) && (src[i] != CH_GT) && (src[i] != CH_DQUOTE) && (src[i] != CH_SQUOTE) && (lone_surrogate_at(src, i) == false) && (dst[k] == src[i]))
}

/// The exact value `safe_batch_size` must return, as a two-branch fact.
///
/// `result > 0` alone is too weak to be useful: it also admits `42` for a
/// non-positive request, so the guard's *value* would rest on the runtime grid
/// test instead of on the proof. Splitting by the sign of `requested` pins both
/// branches without naming a conditional expression.
predicate safe_batch_post(requested : Int, r : Int) {
  ((requested <= 0) && (r == 1)) || ((0 < requested) && (r == requested))
}

/// The exact value `batch_end` must return: `min(start + bs, n)`.
///
/// Written as two branches over `start + bs < n` so that no `min` function is
/// needed in the logic. `start <= result <= n` on its own would also admit the
/// constant `n`, which returns an empty slice for every batch but the last.
predicate batch_end_post(start : Int, bs : Int, n : Int, r : Int) {
  ((start + bs < n) && (r == start + bs)) || ((n <= start + bs) && (r == n))
}
